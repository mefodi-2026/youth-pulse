{
  "rules": {
    "users": {
      ".read": "auth != null && auth.token.platformAdmin === true",
      "$uid": {
        ".read": "auth != null && (auth.uid === $uid || auth.token.platformAdmin === true)",
        ".write": "auth != null && (auth.token.platformAdmin === true || (auth.uid === $uid && newData.exists()))",
        ".validate": "newData.hasChildren(['uid','fullName','phone','email','workspaceId','status','createdAt','updatedAt']) && !newData.child('password').exists() && newData.child('uid').val() === $uid && newData.child('fullName').isString() && newData.child('phone').isString() && newData.child('email').isString() && newData.child('workspaceId').isString() && (newData.child('status').val() === 'pending' || newData.child('status').val() === 'active' || newData.child('status').val() === 'paused' || newData.child('status').val() === 'revoked') && (!data.exists() ? (newData.child('status').val() === 'pending' || (newData.child('status').val() === 'active' && root.child('invites').child(newData.child('inviteCode').val()).child('status').val() === 'active')) : (auth.token.platformAdmin === true || (newData.child('uid').val() === data.child('uid').val() && newData.child('workspaceId').val() === data.child('workspaceId').val() && newData.child('status').val() === data.child('status').val())))"
      }
    },
    "workspaces": {
      ".read": "auth != null && auth.token.platformAdmin === true",
      "$workspaceId": {
        ".read": "auth != null && (data.child('ownerUid').val() === auth.uid || auth.token.platformAdmin === true)",
        ".write": "auth != null && (auth.token.platformAdmin === true || (!data.exists() && newData.child('ownerUid').val() === auth.uid) || (data.exists() && data.child('ownerUid').val() === auth.uid && root.child('users').child(auth.uid).child('status').val() === 'active' && newData.child('ownerUid').val() === data.child('ownerUid').val()))",
        ".validate": "newData.hasChildren(['id','name','city','ownerUid','createdAt','updatedAt']) && newData.child('id').val() === $workspaceId && newData.child('ownerUid').isString()",
        "workspacePacks": {
          "$packId": {
            ".read": "auth != null && (auth.token.platformAdmin === true || (root.child('workspaces').child($workspaceId).child('ownerUid').val() === auth.uid && data.child('mode').val() !== 'quiz'))",
            ".write": "auth != null && (auth.token.platformAdmin === true || (root.child('workspaces').child($workspaceId).child('ownerUid').val() === auth.uid && root.child('users').child(auth.uid).child('status').val() === 'active' && data.child('mode').val() !== 'quiz' && newData.child('mode').val() !== 'quiz'))",
            ".validate": "newData.hasChildren(['productId','gameTypeId','packId','packVersion','templateOrigin','workspaceId','title','content','settings']) && newData.child('packId').val() === $packId && newData.child('workspaceId').val() === $workspaceId && newData.child('templateOrigin').val() === 'workspace' && newData.child('content').child('questions').hasChildren()"
          }
        },
        "workspacePackPublics": {
          ".read": "auth != null && (auth.token.platformAdmin === true || root.child('workspaces').child($workspaceId).child('ownerUid').val() === auth.uid)",
          "$packId": {
            ".write": "auth != null && auth.token.platformAdmin === true",
            ".validate": "newData.hasChildren(['productId','gameTypeId','packId','packVersion','templateOrigin','workspaceId','title','content','settings']) && newData.child('packId').val() === $packId && newData.child('workspaceId').val() === $workspaceId && newData.child('templateOrigin').val() === 'workspace' && !newData.child('privateContent').exists()"
          }
        }
      }
    },
    "workspaceProducts": {
      "$workspaceId": {
        ".read": "auth != null && (root.child('workspaces').child($workspaceId).child('ownerUid').val() === auth.uid || auth.token.platformAdmin === true)",
        "$productId": {
          ".write": "auth != null && (auth.token.platformAdmin === true || (!data.exists() && root.child('workspaces').child($workspaceId).child('ownerUid').val() === auth.uid))"
        }
      }
    },
    "products": {
      ".read": "auth != null && auth.token.platformAdmin === true",
      "$productId": {
        ".read": "auth != null && auth.token.firebase.sign_in_provider !== 'anonymous'",
        ".write": "auth != null && auth.token.platformAdmin === true"
      }
    },
    "invites": {
      "$code": {
        ".read": "auth != null && auth.token.firebase.sign_in_provider !== 'anonymous'",
        ".write": "auth != null && auth.token.platformAdmin === true"
      }
    },
    "globalPacks": {
      "$packId": {
        ".read": "auth != null && auth.token.platformAdmin === true",
        ".write": "auth != null && auth.token.platformAdmin === true"
      }
    },
    "publishedPacks": {
      ".indexOn": ["status"],
      ".read": "auth != null && auth.token.firebase.sign_in_provider !== 'anonymous' && (auth.token.platformAdmin === true || (query.orderByChild === 'status' && query.equalTo === 'published'))",
      "$packId": {
        ".read": "auth != null && auth.token.firebase.sign_in_provider !== 'anonymous' && (auth.token.platformAdmin === true || data.child('status').val() === 'published')",
        ".write": "auth != null && auth.token.platformAdmin === true",
        ".validate": "newData.hasChildren(['productId','gameTypeId','packId','packVersion','templateOrigin','title','description','content','settings','status']) && newData.child('packId').val() === $packId && newData.child('templateOrigin').val() === 'system' && newData.child('content').child('questions').hasChildren() && (newData.child('status').val() === 'published' || newData.child('status').val() === 'archived' || newData.child('status').val() === 'draft') && !newData.child('privateContent').exists()"
      }
    },
    "workspacePacks": {
      "$workspaceId": {
        ".read": "auth != null && (root.child('workspaces').child($workspaceId).child('ownerUid').val() === auth.uid || auth.token.platformAdmin === true)",
        "$packId": { ".write": "auth != null && auth.token.platformAdmin === true" }
      }
    },
    "questionBank": { ".read": "auth != null && auth.token.platformAdmin === true", ".write": "auth != null && auth.token.platformAdmin === true" },
    "roomLobbies": {
      "$roomId": {
        ".read": "auth != null && !root.child('publicRooms').child($roomId).exists()",
        ".write": "auth != null && auth.token.firebase.sign_in_provider !== 'anonymous' && (auth.token.platformAdmin === true || (!data.exists() && newData.child('hostUid').val() === auth.uid && root.child('users').child(auth.uid).child('status').val() === 'active') || (data.exists() && data.child('hostUid').val() === auth.uid))"
      }
    },
    "publicRooms": {
      "$roomId": {
        ".read": "auth != null",
        ".write": "auth != null && (auth.token.platformAdmin === true || (!data.exists() && root.child('sessions').child($roomId).child('hostUid').val() === auth.uid))",
        ".validate": "newData.hasChildren(['roomId','phase','maxParticipants','createdAt']) && newData.child('roomId').val() === $roomId && !newData.child('hostUid').exists() && !newData.child('workspaceId').exists() && !newData.child('participants').exists() && !newData.child('questions').exists()",
        "phase": { ".write": "auth != null && (auth.token.platformAdmin === true || root.child('sessions').child($roomId).child('hostUid').val() === auth.uid)" },
        "closedAt": { ".write": "auth != null && (auth.token.platformAdmin === true || root.child('sessions').child($roomId).child('hostUid').val() === auth.uid)" },
        "roomTitle": { ".write": "auth != null && (auth.token.platformAdmin === true || root.child('sessions').child($roomId).child('hostUid').val() === auth.uid)" }
      }
    },
    "roomParticipantQuestions": {
      "$roomId": {
        ".read": "auth != null",
        ".write": "auth != null && (auth.token.platformAdmin === true || (!data.exists() && root.child('sessions').child($roomId).child('hostUid').val() === auth.uid))",
        ".validate": "newData.hasChildren(['roomId','createdAt','questions']) && newData.child('roomId').val() === $roomId && newData.child('questions').hasChildren()",
        "questions": {
          "$questionId": {
            ".validate": "newData.hasChildren(['id','title','options']) && newData.child('id').val() === $questionId && !newData.child('correctAnswer').exists() && !newData.child('explanation').exists()"
          }
        }
      }
    },
    "roomPrivateQuestions": {
      "$roomId": {
        ".read": "auth != null && (auth.token.platformAdmin === true || root.child('sessions').child($roomId).child('hostUid').val() === auth.uid)",
        ".write": "auth != null && auth.token.platformAdmin === true",
        ".validate": "newData.hasChildren(['roomId','createdAt','questions']) && newData.child('roomId').val() === $roomId && newData.child('questions').hasChildren()"
      }
    },
    "roomParticipantResults": {
      "$roomId": {
        ".read": "auth != null && (auth.token.platformAdmin === true || root.child('sessions').child($roomId).child('hostUid').val() === auth.uid)",
        "$participantId": {
          ".read": "auth != null && (auth.uid === $participantId || auth.token.platformAdmin === true || root.child('sessions').child($roomId).child('hostUid').val() === auth.uid)",
          ".write": "auth != null && (auth.token.platformAdmin === true || (root.child('sessions').child($roomId).child('hostUid').val() === auth.uid && root.child('sessions').child($roomId).child('mode').val() !== 'quiz'))"
        }
      }
    },
    "sessions": {
      ".read": "auth != null && auth.token.platformAdmin === true",
      "$roomId": {
        ".read": "auth != null && (data.child('hostUid').val() === auth.uid || auth.token.platformAdmin === true)",
        ".write": "auth != null && (auth.token.platformAdmin === true || (!data.exists() && auth.token.firebase.sign_in_provider !== 'anonymous' && newData.child('roomId').val() === $roomId && newData.child('hostUid').val() === auth.uid && newData.child('workspaceId').isString() && newData.child('productId').isString() && root.child('users').child(auth.uid).child('workspaceId').val() === newData.child('workspaceId').val() && root.child('users').child(auth.uid).child('status').val() === 'active' && root.child('workspaces').child(newData.child('workspaceId').val()).child('ownerUid').val() === auth.uid))",
        ".validate": "(data.exists() && !data.child('snapshotId').exists()) || (newData.hasChildren(['roomId','createdAt','phase','maxParticipants','hostUid','workspaceId','productId','mode','packId','packVersion','snapshotId','packSnapshot','settings']) && newData.child('roomId').val() === $roomId && (newData.child('mode').val() === 'diagnostic' || newData.child('mode').val() === 'quiz') && (newData.child('phase').val() === 'lobby' || newData.child('phase').val() === 'live' || newData.child('phase').val() === 'personal' || newData.child('phase').val() === 'resultsIntro' || newData.child('phase').val() === 'resultsReal' || newData.child('phase').val() === 'closed'))",
        "mode": { ".validate": "!data.exists() || newData.val() === data.val()" },
        "packId": { ".validate": "!data.exists() || newData.val() === data.val()" },
        "packVersion": { ".validate": "!data.exists() || newData.val() === data.val()" },
        "snapshotId": { ".validate": "!data.exists() || newData.val() === data.val()" },
        "packSnapshot": { ".validate": "!data.exists() || newData.val() === data.val()" },
        "templateSnapshot": { ".validate": "!data.exists() || newData.val() === data.val()" },
        "questions": { ".validate": "!data.exists() || newData.val() === data.val()" },
        "settings": { ".validate": "!data.exists() || newData.val() === data.val()" },
        "scoringMap": { ".validate": "!data.exists() || newData.val() === data.val()" },
        "phase": { ".write": "auth != null && (auth.token.platformAdmin === true || (data.parent().child('hostUid').val() === auth.uid && root.child('users').child(auth.uid).child('status').val() === 'active'))" },
        "startedAt": { ".write": "auth != null && data.parent().child('hostUid').val() === auth.uid" },
        "closedAt": { ".write": "auth != null && data.parent().child('hostUid').val() === auth.uid" },
        "resultsIntroStartedAt": { ".write": "auth != null && data.parent().child('hostUid').val() === auth.uid" },
        "participantCount": { ".write": "auth != null && data.parent().child('hostUid').val() === auth.uid" },
        "completedCount": { ".write": "auth != null && data.parent().child('hostUid').val() === auth.uid" },
        "roomTitle": { ".write": "auth != null && data.parent().child('hostUid').val() === auth.uid" },
        "events": {
          "$eventId": {
            ".write": "auth != null && !data.exists() && ((root.child('sessions').child($roomId).child('hostUid').val() === auth.uid && auth.token.firebase.sign_in_provider !== 'anonymous') || (auth.uid === newData.child('participantId').val() && auth.token.firebase.sign_in_provider === 'anonymous' && root.child('sessions').child($roomId).child('phase').val() !== 'closed'))"
          }
        },
        "participants": {
          "$participantId": {
            ".read": "auth != null && (auth.uid === $participantId || root.child('sessions').child($roomId).child('hostUid').val() === auth.uid || auth.token.platformAdmin === true)",
            ".write": "auth != null && auth.uid === $participantId && auth.token.firebase.sign_in_provider === 'anonymous' && !data.exists() && root.child('sessions').child($roomId).child('phase').val() !== 'closed' && newData.child('id').val() === auth.uid",
            "answers": { "$questionId": { ".write": "auth != null && auth.uid === $participantId && auth.token.firebase.sign_in_provider === 'anonymous' && root.child('sessions').child($roomId).child('mode').val() !== 'quiz' && root.child('sessions').child($roomId).child('phase').val() === 'live'" } },
            "currentQuestionIndex": { ".write": "auth != null && auth.uid === $participantId && auth.token.firebase.sign_in_provider === 'anonymous' && root.child('sessions').child($roomId).child('mode').val() !== 'quiz' && root.child('sessions').child($roomId).child('phase').val() === 'live'" },
            "status": { ".write": "auth != null && auth.uid === $participantId && auth.token.firebase.sign_in_provider === 'anonymous' && root.child('sessions').child($roomId).child('mode').val() !== 'quiz' && root.child('sessions').child($roomId).child('phase').val() === 'live'" },
            "completedAt": { ".write": "auth != null && auth.uid === $participantId && auth.token.firebase.sign_in_provider === 'anonymous' && root.child('sessions').child($roomId).child('mode').val() !== 'quiz' && root.child('sessions').child($roomId).child('phase').val() === 'live'" },
            "personalViewedAt": { ".write": "auth != null && auth.uid === $participantId && root.child('sessions').child($roomId).child('phase').val() !== 'closed'" }
          }
        }
      }
    },
    "sessionArchives": {
      "$roomId": {
        ".read": "auth != null && (data.child('hostUid').val() === auth.uid || auth.token.platformAdmin === true)",
        ".write": "auth != null && (auth.token.platformAdmin === true || (!data.exists() && newData.child('hostUid').val() === auth.uid))"
      }
    },
    "workspaceArchives": {
      "$workspaceId": {
        ".read": "auth != null && (root.child('workspaces').child($workspaceId).child('ownerUid').val() === auth.uid || auth.token.platformAdmin === true)",
        "$roomId": { ".write": "auth != null && (auth.token.platformAdmin === true || (!data.exists() && root.child('workspaces').child($workspaceId).child('ownerUid').val() === auth.uid && newData.child('workspaceId').val() === $workspaceId))" }
      }
    },
    "feedback": {
      ".read": "auth != null && auth.token.platformAdmin === true",
      "$feedbackId": { ".write": "auth != null && (auth.token.platformAdmin === true || (!data.exists() && auth.token.firebase.sign_in_provider !== 'anonymous' && newData.child('uid').val() === auth.uid && newData.child('workspaceId').val() === root.child('users').child(auth.uid).child('workspaceId').val()))" }
    }
  }
}
